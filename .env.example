# Flask Configuration
FLASK_SECRET_KEY=evaluator-tp10-production-secret-key-replace-me
FLASK_ENV=production

# Database Configuration (SQLite is used by default; on Vercel it uses /tmp/evaluator.db)
# DATABASE_URL=sqlite:////tmp/evaluator.db

# AI / LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
DEFAULT_LLM_PROVIDER=gemini

# Optional: Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional: Qdrant Vector Database (Leave blank for fast in-memory/local storage)
# QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key
